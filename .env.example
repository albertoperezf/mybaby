# Optional: closed-app reminder alerts (Web Push). Leave all of these unset to run without push.

# Generate with: npm run push:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# From https://console.upstash.com/qstash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Only if your QStash is in a non-default region
# QSTASH_URL=

# Public https origin QStash calls back. On Vercel this is derived from the production domain automatically.
# PUSH_BASE_URL=https://mybaby.example.com
